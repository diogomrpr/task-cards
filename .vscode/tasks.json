{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile",
      "type": "shell",
      "command": "pnpm run compile",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Watch",
      "type": "shell",
      "command": "pnpm run watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    },
    {
      "label": "Test unit",
      "type": "shell",
      "command": "pnpm run test:unit",
      "problemMatcher": []
    },
    {
      "label": "Test integration",
      "type": "shell",
      "command": "pnpm run test:integration",
      "problemMatcher": []
    },
    {
      "label": "Audit dependencies",
      "type": "shell",
      "command": "pnpm run audit",
      "problemMatcher": []
    },
    {
      "label": "Package extension",
      "type": "shell",
      "command": "pnpm run package",
      "problemMatcher": []
    }
  ]
}
